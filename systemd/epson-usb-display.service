[Unit]
Description=Epson projector USB Display (virtual monitor over USB-B)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/share/epson-usb-display/.venv/bin/python -u -m epson_ud
WorkingDirectory=%h/.local/share/epson-usb-display
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
